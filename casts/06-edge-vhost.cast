[0.007428, "o", "=== [1] Symptom recap: NodePort OK, edge still 502\r\n"]
[0.016619, "o", "edge  /products -> 502\r\n"]
[0.08473, "o", "node :31994  -> 200\r\n"]
[0.089197, "o", "\r\n=== [2] Which config is the edge actually running?\r\n"]
[0.089631, "o", "--- includes in main nginx.conf (deployed by ansible):\r\n"]
[0.151926, "o", "9:    include mime.types;\r\n20:    include /usr/local/openresty/nginx/conf/sites-enabled/*.conf;\r\n"]
[0.156609, "o", "--- upstream in the RUNNING config (openresty -T):\r\n"]
[0.228425, "o", "    server shoplite-control-plane:32377;\r\n"]
[0.236292, "o", "--- where ansible put the rendered vhost (not included anywhere):\r\n"]
[0.29367, "o", "2:    server shoplite-control-plane:31994;\r\n6:server {\r\n7:    listen 80 default_server;\r\n8:    server_name _;\r\n"]
[0.294807, "o", "shop.conf\r\n"]
[0.299447, "o", "--- baked vhost that is actually loaded:\r\n"]
[0.361651, "o", "2:    server shoplite-control-plane:32377;\r\n6:server {\r\n7:    listen 80 default_server;\r\n8:    server_name _;\r\n"]
[0.365596, "o", "\r\n=== [3] Conclusion\r\nplaybook: dest=/etc/nginx/conf.d/shop.conf, but nginx.conf includes sites-enabled/*.conf;\r\n"]
[0.366568, "o", "=> rendered vhost never loads; edge serves stale baked vhost with old nodePort 32377.\r\nAlso: metrics-allowlist (shell echo >>) appends on every run -> changed!=0 (criterion 2).\r\n\r\n=== [4] Fix ansible/edge.yml in repo\r\n"]
[0.372995, "o", " ansible/edge.yml | 11 \u001b[32m++++++++\u001b[m\u001b[31m---\u001b[m\r\n 1 file changed, 8 insertions(+), 3 deletions(-)\r\n"]
[0.384705, "o", "5ce6516 A2: deploy vhost to sites-enabled (was dead conf.d), idempotent metrics allowlist\r\na669a4a A1: fix Service targetPort 8000 -> 8800 (app listens on 8800)\r\n"]
[0.387032, "o", "\r\n=== [5] Apply: run playbook twice, expect 1st changed, 2nd changed=0\r\n"]
[8.049328, "o", "RUNNING HANDLER [Apply reload] *************************************************\r\nchanged: [edge1]\r\n\r\nPLAY RECAP *********************************************************************\r\nedge1                      : ok=5    changed=4    unreachable=0    failed=0    skipped=0    rescued=0    ignored=0   \r\n\r\n"]
[10.055561, "o", "--- second run:\r\n"]
[15.596254, "o", "TASK [Metrics allowlist] *******************************************************\r\nok: [edge1]\r\n\r\nPLAY RECAP *********************************************************************\r\nedge1                      : ok=3    changed=0    unreachable=0    failed=0    skipped=0    rescued=0    ignored=0   \r\n\r\n"]
[15.596875, "o", "\r\n=== [6] Verify\r\n--- running upstream now:\r\n"]
[15.66044, "o", "    server shoplite-control-plane:31994;\r\n"]
[15.726078, "o", "allow 127.0.0.1;\r\nallow 172.16.0.0/12;\r\n"]
[17.744683, "o", "edge /products -> 200\r\n"]
